# /etc/bike-station/server.env  (mode 640, group bikestation) - PLACEHOLDERS only!
# deploy/install-server.sh writes this file automatically for a self-hosted installation.
# Create a data key:  python3 -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
BIKE_ENV=production
BIKE_BASE_URL=https://bikes.example.org
BIKE_ALLOWED_HOSTS=bikes.example.org
BIKE_DATA_KEY=REPLACE_WITH_DATA_KEY
BIKE_DB_PATH=/var/lib/bike-station/bike_station.db
BIKE_CONFIG=/opt/bike-station/server/config.toml
BIKE_MAIL_BACKEND=smtp
BIKE_SMTP_HOST=smtp.example.org
BIKE_SMTP_PORT=587
BIKE_SMTP_USER=REPLACE
BIKE_SMTP_PASSWORD=REPLACE
# Only set to 1 behind a trusted reverse proxy that sets X-Forwarded-For.
BIKE_TRUST_PROXY=0
