# /etc/bike-station/api.env  (chmod 640, Gruppe bikestation)
# Nur Platzhalter! Echte Tokens erzeugen mit:  python3 -c "import secrets;print(secrets.token_urlsafe(32))"
BIKE_DEVICE_TOKENS=REPLACE_WITH_DEVICE_TOKEN
BIKE_ADMIN_TOKENS=REPLACE_WITH_ADMIN_TOKEN
BIKE_DB_PATH=/var/lib/bike-station/bike_station.db
BIKE_CONFIG=/opt/smart-bike-station/backend/config.toml
# Nur auf 1 setzen, wenn ein Reverse-Proxy davor sitzt und X-Forwarded-For setzt.
BIKE_TRUST_PROXY=0
