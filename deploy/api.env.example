# /etc/bike-station/api.env  (chmod 640, Gruppe bikestation) – NUR Platzhalter!
# Datenschlüssel erzeugen:  python3 -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
BIKE_ENV=production
BIKE_BASE_URL=https://radstation.example.org
BIKE_ALLOWED_HOSTS=radstation.example.org
BIKE_DATA_KEY=REPLACE_WITH_DATA_KEY
BIKE_DB_PATH=/var/lib/bike-station/bike_station.db
BIKE_CONFIG=/opt/smart-bike-station/backend/config.toml
BIKE_MAIL_BACKEND=smtp
BIKE_SMTP_HOST=smtp.example.org
BIKE_SMTP_PORT=587
BIKE_SMTP_USER=REPLACE
BIKE_SMTP_PASSWORD=REPLACE
# Nur auf 1 setzen, wenn ein vertrauenswürdiger Reverse-Proxy davor sitzt und X-Forwarded-For setzt.
BIKE_TRUST_PROXY=0
