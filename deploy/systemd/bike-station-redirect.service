# Redirects http:// (port @HTTP_PORT@) to https:// - installed by deploy/install-server.sh.
[Unit]
Description=Smart Bike Station - HTTP to HTTPS redirect
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
Group=@USER@
WorkingDirectory=@PREFIX@/server
EnvironmentFile=@ETC@/server.env
EnvironmentFile=-@ETC@/server.env.local
ExecStart=@PREFIX@/venv/bin/python -m app.redirect --port @HTTP_PORT@
Restart=on-failure
RestartSec=3
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RestrictAddressFamilies=AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
