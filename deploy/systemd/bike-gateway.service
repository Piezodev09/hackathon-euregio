# Raspberry Pi: Gateway Arduino -> API. Startet automatisch beim Booten (Plan 3.1).
[Unit]
Description=Smart Bicycle Box - Pi-Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bikegw
Group=dialout
WorkingDirectory=/opt/smart-bike-station/pi-gateway
EnvironmentFile=/etc/bike-gateway/gateway.env
ExecStart=/usr/bin/python3 /opt/smart-bike-station/pi-gateway/gateway.py --config /etc/bike-gateway/config.toml
Restart=always
RestartSec=3

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
StateDirectory=bike-gateway

[Install]
WantedBy=multi-user.target
