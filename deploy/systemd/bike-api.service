# Platform (API + portal + AI) - installed by deploy/install-server.sh
[Unit]
Description=Smart Bike Station - platform
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bikestation
Group=bikestation
WorkingDirectory=/opt/bike-station/server
# Secrets are NOT stored here but in /etc/bike-station/server.env (mode 640)
EnvironmentFile=/etc/bike-station/server.env
ExecStart=/opt/bike-station/venv/bin/uvicorn app.main:_app_factory --factory \
    --host 0.0.0.0 --port 8443 \
    --ssl-keyfile /etc/bike-station/tls/server.key \
    --ssl-certfile /etc/bike-station/tls/server.crt \
    --no-server-header
Restart=on-failure
RestartSec=3

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/bike-station
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
